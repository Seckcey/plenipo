{
  "name": "plenipo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plenipo — local-first desktop AI workforce orchestration platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plenipo/desktop tauri dev",
    "build": "pnpm --filter @plenipo/desktop tauri build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "versions:check": "node scripts/check-versions.mjs",
    "bindings": "cargo test -p plenipo-core export_bindings",
    "check": "pnpm versions:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
