# Plenipo website: follow the latest published release (ADR-069).
# Installed to /etc/systemd/system/ on Coastline; see docs/development/website.md.
[Unit]
Description=Plenipo website: show the latest published release and its notes
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# The account that owns /srv/8west/apps/plenipo-website and may use Docker. The install steps
# fill it in; the service never runs as root.
User=DEPLOY_USER
ExecStart=/srv/8west/apps/plenipo-website/bin/auto-release.sh
# A build is allowed up to 20 minutes; a stuck run is stopped, and the next timer run tries again.
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
