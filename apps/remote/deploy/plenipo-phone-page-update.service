# Plenipo on your phone: serve the phone's page from each release (Phase 14, ADR-146 and ADR-148;
# ADR-210, the page and the relay are signed like the installer).
# Installed to /etc/systemd/system/ on the page's own server; see apps/remote/deploy/README.md.
[Unit]
Description=Plenipo on your phone: serve the newest release of the phone's page
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# The account that owns /srv/8west/apps/plenipo-phone-page and may use Docker. The install steps
# fill it in; the service never runs as root.
User=DEPLOY_USER
ExecStart=/srv/8west/apps/plenipo-phone-page/deploy/update-page.sh
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
# It sees as little as it can: home folders read-only (Docker reads its settings there), nothing
# of the kernel's, and /usr, /boot, and /etc read-only (it writes under /srv only).
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
