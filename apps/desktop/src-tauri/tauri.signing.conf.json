{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "artifact-signing-cli",
        "args": [
          "-e",
          "https://eus.codesigning.azure.net",
          "-a",
          "eightwest-signing",
          "-c",
          "eightwest-public",
          "-d",
          "Plenipo",
          "%1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  }
}
