{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus Plenipo's typed commands. No OS plugins (fs, shell, http, process) are granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-info",
    "allow-frontend-ready",
    "allow-get-runtime-overview",
    "allow-start-execution",
    "allow-cancel-execution",
    "allow-get-execution-output"
  ]
}
