{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus Plenipo's typed commands. No OS plugins (fs, shell, http, process) are granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-info",
    "allow-frontend-ready",
    "allow-get-runtime-overview",
    "allow-start-execution",
    "allow-cancel-execution",
    "allow-get-execution-output",
    "allow-get-ledger-status",
    "allow-list-tasks",
    "allow-get-task-timeline",
    "allow-list-recent-events",
    "allow-create-synthetic-task",
    "allow-advance-synthetic-task",
    "allow-run-integrity-check",
    "allow-create-ledger-backup",
    "allow-export-ledger",
    "allow-get-agent-overview",
    "allow-refresh-agent-runtimes",
    "allow-get-agent-session",
    "allow-start-agent-session",
    "allow-resume-agent-session",
    "allow-cancel-agent-turn",
    "allow-close-agent-session",
    "allow-get-task-handoffs",
    "allow-get-task-tree",
    "allow-get-liaison-overview",
    "allow-get-organization",
    "allow-get-work",
    "allow-rename-organization",
    "allow-set-organization-titles",
    "allow-create-role",
    "allow-create-department",
    "allow-update-department",
    "allow-remove-department",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-hire-position",
    "allow-fill-position",
    "allow-vacate-position",
    "allow-update-position",
    "allow-move-position",
    "allow-archive-position",
    "allow-assign-oversight",
    "allow-end-oversight",
    "allow-give-objective",
    "allow-get-routing",
    "allow-save-model",
    "allow-remove-model",
    "allow-set-role-policy",
    "allow-set-routing-options",
    "allow-clear-usage-limit",
    "allow-get-permissions",
    "allow-save-permission-set",
    "allow-remove-permission-set",
    "allow-assign-permissions",
    "allow-set-command-rules",
    "allow-set-blocked-files",
    "allow-set-sensitive-rule",
    "allow-set-guard-options",
    "allow-save-secret",
    "allow-remove-secret",
    "allow-get-approvals",
    "allow-resolve-approval",
    "allow-revoke-grant"
  ]
