# Plenipo's relay: its settings (Phase 14, ADR-149). Copied to /etc/plenipo-relay/relay.env by
# install-relay.sh. `plenipo-relay --help` lists every setting. Nothing here is a secret.

# Where it listens. 127.0.0.1 and a free port, or this machine's address on the Docker bridge
# (for example 172.17.0.1) when the proxy runs in a container and cannot reach the host's
# 127.0.0.1. Never an address the internet can reach: the relay refuses one.
PLENIPO_RELAY_LISTEN=127.0.0.1:8790

# Where a connection's internet address is read, for the limits per address:
#   proxy       behind Nginx Proxy Manager, with the name pointed straight at this machine (default)
#   cloudflare  behind the proxy, with the Cloudflare record proxied (orange cloud)
#   peer        no proxy (the tests)
PLENIPO_RELAY_CLIENT_ADDRESS=proxy

# The off switch: while this file exists, every connection is closed and new ones are turned away.
PLENIPO_RELAY_OFF_FILE=/etc/plenipo-relay/off

# error, warn, info, or debug.
PLENIPO_RELAY_LOG=info
