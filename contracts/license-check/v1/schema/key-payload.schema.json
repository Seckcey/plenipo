{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://account.getplenipo.com/contracts/license-check/v1/key-payload.schema.json",
  "title": "What a license key says",
  "description": "The key is plenipo1.<this JSON in base64url>.<Ed25519 signature over \"plenipo-license-key.v1.\" followed by that base64url text>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "edition", "key_id", "holder", "plan", "paid_through", "issued_at", "signer"],
  "properties": {
    "v": { "const": 1 },
    "edition": { "const": "pro" },
    "key_id": { "type": "string", "pattern": "^lk_[0-9A-HJKMNP-TV-Z]{26}$" },
    "holder": { "type": "string", "minLength": 1, "maxLength": 120 },
    "plan": { "enum": ["monthly", "yearly"] },
    "paid_through": { "type": "integer" },
    "issued_at": { "type": "integer", "exclusiveMinimum": 0 },
    "signer": { "type": "string", "minLength": 1, "maxLength": 40 }
  }
}
