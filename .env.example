# Plenipo local environment example.
# Copy to `.env` only if you need to override a default. `.env` is git-ignored.
# Phase 0 requires NO variables: the app launches with none set.
# Never place provider API keys, passwords, or tokens in this file.

# Rust log filter for the desktop backend (default: info).
# RUST_LOG=info

# CI/automation only: launch, wait for the UI to report ready, then exit 0 (or 1 on timeout).
# PLENIPO_SMOKE_TEST=1
